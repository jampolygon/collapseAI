{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/offline-maps/regions.json",
      "destination": "https://github.com/jampolygon/collapseAI/releases/download/offline-maps-v1/regions.json"
    },
    {
      "source": "/offline-maps/philippines.pmtiles",
      "destination": "https://github.com/jampolygon/collapseAI/releases/download/offline-maps-v1/philippines.pmtiles"
    }
  ]
}
